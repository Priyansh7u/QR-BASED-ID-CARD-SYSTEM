# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Password for the admin panel
ADMIN_PASSWORD=choose-a-strong-password

# Any long random string (used to sign the admin login cookie)
SESSION_SECRET=paste-a-long-random-string-here

# Your final website address, no trailing slash.
# The QR codes point here, so set it BEFORE printing cards and never change it.
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
